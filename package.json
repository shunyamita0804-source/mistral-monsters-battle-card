{
  "name": "mistral-monsters-battle-card",
  "version": "0.4.0",
  "private": true,
  "description": "ミストラルモンスターズ バトルカード — スマートフォン向け2Dカードゲーム（ミストラルモンスターズシリーズ）",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "art:skillframes": "python3 -I tools/art/skillcard_simple_build.py && python3 -I tools/art/value_box_build.py && python3 -I tools/art/old_parts_build.py",
    "playtest:pukarim": "PLAYTEST=200 PLAYTEST_OUT=docs/design/pukarim-20261028/playtest_200.json vitest run tests/pukarimPlaytest.test.ts",
    "playtest:geol": "PLAYTEST=200 PLAYTEST_OUT=docs/design/geol-20261029/playtest_200.json vitest run tests/geolPlaytest.test.ts",
    "playtest:flune": "PLAYTEST=200 PLAYTEST_OUT=docs/design/flune-20261029/playtest_200.json vitest run tests/flunePlaytest.test.ts",
    "playtest:zephyra": "PLAYTEST=200 PLAYTEST_OUT=docs/design/wind-valley-20261030/playtest_200.json vitest run tests/zephyraPlaytest.test.ts",
    "playtest:lazuck": "PLAYTEST=200 PLAYTEST_OUT=docs/design/lazuck-20261029/playtest_200_after.json vitest run tests/lazuckPlaytest.test.ts",
    "playtest:rekka": "PLAYTEST=200 PLAYTEST_OUT=docs/design/rekka-20261029/playtest_200.json vitest run tests/rekkaPlaytest.test.ts",
    "playtest:hyouzuku": "PLAYTEST=200 PLAYTEST_OUT=docs/design/hyouzuku-w-20261030/hyouzuku_200.json vitest run tests/hyouzukuPlaytest.test.ts",
    "playtest:boxes": "PLAYTEST=200 PLAYTEST_OUT=docs/design/cpu-skill-z-20261030/boxes_200.json vitest run tests/boxPlaytest.test.ts",
    "playtest:swap": "PLAYTEST=200 PLAYTEST_OUT=docs/design/cpu-skill-z-20261030/swap_200.json vitest run tests/swapPlaytest.test.ts",
    "playtest:bosses": "PLAYTEST=200 PLAYTEST_OUT=docs/design/cpu-skill-z-20261030/bosses_200.json vitest run tests/bossPlaytest.test.ts",
    "playtest:shishien": "PLAYTEST=200 PLAYTEST_SUBJECTS=mon-shishien PLAYTEST_OUT=docs/design/shishien-ab-20261031/swap_200.json vitest run tests/swapPlaytest.test.ts",
    "playtest:hakuran": "PLAYTEST=200 PLAYTEST_SUBJECTS=mon-hakuran PLAYTEST_OUT=docs/design/hakuran-af2-20261031/swap_200.json vitest run tests/swapPlaytest.test.ts",
    "playtest:desuoru": "PLAYTEST=200 PLAYTEST_SUBJECTS=mon-desuoru PLAYTEST_OUT=docs/design/desuoru-ag-20261031/swap_200.json vitest run tests/swapPlaytest.test.ts",
    "playtest:desuoru-rare": "PLAYTEST=200 PLAYTEST_SUBJECTS=mon-desuoru PLAYTEST_WITH_RARE=1 PLAYTEST_OUT=docs/design/desuoru-ag-20261031/swap_rare_200.json vitest run tests/swapPlaytest.test.ts",
    "playtest:barca": "PLAYTEST=1000 PLAYTEST_BOSSES=enc-fire-boss PLAYTEST_SCALES=1.0:1.09:0.01 PLAYTEST_OUT=docs/design/barca-ac-20261031/barca_scan_1000.json vitest run tests/bossPlaytest.test.ts",
    "playtest:regulars": "PLAYTEST=200 PLAYTEST_OUT=docs/design/cpu-skill-z-20261030/regulars_200.json vitest run tests/regularsPlaytest.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.1.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "budoux": "0.7.0"
  }
}
