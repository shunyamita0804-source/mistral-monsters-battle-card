{
  "name": "mistral-monsters-battle-card",
  "version": "0.4.0",
  "private": true,
  "description": "ミストラルモンスターズ バトルカード — スマートフォン向け2Dカードゲーム（ミストラルモンスターズシリーズ）",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.1.0",
    "vitest": "^4.0.0"
  }
}
